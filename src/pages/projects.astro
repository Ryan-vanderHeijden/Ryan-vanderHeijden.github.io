---
import Layout from '../layouts/Layout.astro';
import TerminalFrame from '../components/TerminalFrame.astro';

const projects = [
  {
    slug: 'hydro2dRP',
    title: 'Bivariate dependency modeling for joint return periods',
    year: '2025',
    tags: ['python', 'hydrology', 'extreme value', 'return period'],
    description:
      'Tools for bivariate extreme value analysis using the Gumbel copula, including Kendall risk contours. Intended for modeling joint-extremeness of hydrologic signals, but flexible and extensible to other use cases.',
    link: 'https://github.com/Ryan-vanderHeijden/hydro2dRP',
  },
  {
    slug: 'Drought Explorer',
    title: 'Drought Exploration App',
    year: '2025',
    tags: ['data-visualization', 'drought', 'Colorado River Basin'],
    description:
      'An application built with Flask for visualizing historical drought events (identified using HyMED-Python) and evaluating current streamflow drought conditions in the Colorado River Basin.',
    link: 'https://github.com/Ryan-vanderHeijden/Drought_explorer',
  },
  {
    slug: 'HyMED-Python',
    title: 'HyMED-Python',
    year: '2025',
    tags: ['python', 'model diagnostics', 'drought', 'benchmarking'],
    description:
      'A Python translation of the HyMED package (Simeone and Foks, 2024, https://doi.org/10.5066/P1TLARC5). Streamflow drought-specific hydrologic model performance analysis. Drought event identification and quantification.',
    link: 'https://github.com/Ryan-vanderHeijden/HyMED_Python',
  },
];
---

<Layout title="projects" path="/projects">
  <h2 class="page-title">projects</h2>
  <p class="page-sub muted">research, tools, and experiments.</p>

  {projects.map(p => (
    <TerminalFrame title={p.slug}>
      <div class="project">
        <div class="project-header">
          <span class="project-name">{p.title}</span>
          <span class="year muted">{p.year}</span>
        </div>
        <p class="desc">{p.description}</p>
        <div class="meta">
          <span class="tags">
            {p.tags.map(t => <span class="tag">{t}</span>)}
          </span>
          <a href={p.link} class="view-link" target="_blank" rel="noopener">→ view</a>
        </div>
      </div>
    </TerminalFrame>
  ))}
</Layout>

<style>
  .page-title {
    font-size: 1.5rem;
    margin-bottom: 0.3rem;
  }

  .page-sub {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  .muted { color: var(--fg-muted); }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-name {
    font-weight: 500;
    color: var(--fg);
  }

  .year {
    font-size: 0.8rem;
  }

  .desc {
    line-height: 1.65;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 0.6ch;
    flex-wrap: wrap;
  }

  .tag {
    color: var(--ansi-cyan);
    font-size: 0.8rem;
  }

  .tag::before {
    content: '#';
    color: var(--fg-muted);
  }

  .view-link {
    margin-left: auto;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .view-link:hover {
    color: var(--accent-bright);
  }
</style>
