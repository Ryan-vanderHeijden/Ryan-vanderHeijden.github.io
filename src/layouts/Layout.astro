---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  path?: string;
}

const { title, path = '/' } = Astro.props;
---

<!doctype html>
<html lang="en" data-palette="Shoyu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — ryan.dev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Single source of truth for palettes; used by both FOUC-prevention and toggle -->
    <script is:inline>
      window.PALETTES = [
        { id: 'Shoyu',      color: '#a87c5a', label: 'Shoyu'      },
        { id: 'synthwave',  color: '#ff2a6d', label: 'Synthwave'  },
        { id: 'RV default', color: '#ff79c6', label: 'RV Default' },
        { id: 'dark',       color: '#58a6ff', label: 'Dark'       },
        { id: 'Graham',     color: '#c85000', label: 'Graham'     },
      ];

      // Prevent palette flash before paint
      const saved = localStorage.getItem('palette');
      if (saved && window.PALETTES.some(p => p.id === saved)) {
        document.documentElement.dataset.palette = saved;
      }
    </script>
  </head>
  <body>
    <div id="ascii-bg" aria-hidden="true"></div>
    <div class="site-container">
      <header class="site-header">
        <Nav path={path} />
        <div class="palette-toggle" id="palette-toggle"></div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>© 2026 Ryan van der Heijden</span>
        <span>·</span>
        <a href="https://github.com/Ryan-vanderHeijden" target="_blank" rel="noopener">github</a>
        <span>·</span>
        <a href="https://www.linkedin.com/in/ryan-van-der-heijden-eit/" target="_blank" rel="noopener">linkedin</a>
        <span>·</span>
        <span>no cookies · no analytics · no tracking</span>
      </footer>
    </div>

    <script is:inline>
      function renderToggle() {
        const current = document.documentElement.dataset.palette;
        const el = document.getElementById('palette-toggle');
        if (!el) return;
        el.innerHTML = window.PALETTES.map(p =>
          `<button
            class="palette-btn${p.id === current ? ' active' : ''}"
            data-palette="${p.id}"
            title="${p.label}"
            style="background:${p.color}"
          ></button>`
        ).join('');
        el.querySelectorAll('.palette-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = btn.dataset.palette;
            document.documentElement.dataset.palette = p;
            localStorage.setItem('palette', p);
            renderToggle();
          });
        });
      }

      document.addEventListener('DOMContentLoaded', renderToggle);
    </script>

    <script>
      import '../islands/ascii-bg';
    </script>
  </body>
</html>
