---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'gallery'>;
  /** spans the full row of its section */
  lead?: boolean;
}

const { entry, lead = false } = Astro.props;
const { data } = entry;
const href = data.kind === 'scrolly' && data.href ? data.href : `/work/${entry.id}/`;
---

<a class:list={['tile', { lead }]} href={href}>
  <Picture
    src={data.image}
    alt={data.alt}
    widths={[640, 960, 1400, 2000]}
    sizes={lead ? '(min-width: 960px) 80vw, 100vw' : '(min-width: 960px) 40vw, 100vw'}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
  />
  <span class="label">
    <span class="title">{data.title}</span>
    <span class="summary">{data.summary}</span>
  </span>
</a>

<style>
  .tile { display: block; text-decoration: none; color: inherit; }
  .tile :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .label { display: block; padding-top: 0.75rem; max-width: 34rem; }
  .title { display: block; color: var(--ink); font-size: var(--t-title); }
  .summary { display: block; color: var(--muted); font-size: var(--t-small); line-height: 1.5; margin-top: 0.15rem; }
  .tile:hover .title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
</style>
